  "retrieval_rules": [
    {
      "rule_id": "R-01",
      "scope": "Malaysia Tier 1",
      "rule": "Prefer primary Malaysian legislation/regulations when question is legal/regulatory.",
      "control_type": "Authority-first"
    },
    {
      "rule_id": "R-02",
      "scope": "Malaysia Tier 2",
      "rule": "Use current official Malaysian guidance/forms for operational interpretation and Form E support.",
      "control_type": "Authority-first"
    },
    {
      "rule_id": "R-03",
      "scope": "MOH transport",
      "rule": "Use MOH 2023 for clinical specimen/infectious-substance transport; do not use it as the primary source for clinical waste.",
      "control_type": "Scope-aware"
    },
    {
      "rule_id": "R-04",
      "scope": "WHO Tier 3",
      "rule": "Use WHO when Malaysian sources do not specify the technical principle, or as corroborating risk-based guidance.",
      "control_type": "Authority-aware"
    },
    {
      "rule_id": "R-05",
      "scope": "IBC boundary",
      "rule": "IBC-only assessment fields are contextual and never researcher missing-field requirements.",
      "control_type": "Scope gate"
    },
    {
      "rule_id": "R-06",
      "scope": "Fees",
      "rule": "Fee/payment information is excluded from benchmark and researcher compliance scoring.",
      "control_type": "Scope gate"
    },
    {
      "rule_id": "R-07",
      "scope": "Uncertainty",
      "rule": "Missing/unknown information must reduce confidence and trigger clarification; never infer a specific organism, construct, BSL or exemption.",
      "control_type": "Safety gate"
    },
    {
      "rule_id": "R-08",
      "scope": "Citation",
      "rule": "Material regulatory conclusions must cite the supporting source and identify section/page where available.",
      "control_type": "Evidence gate"
    },
    {
      "rule_id": "R-09",
      "scope": "Currentness",
      "rule": "Where current JBK operational page conflicts with older procedural material, flag reconciliation and prefer the current official operational statement.",
      "control_type": "Currentness gate"
    },
    {
      "rule_id": "R-10",
      "scope": "No approval claim",
      "rule": "BioSafe may identify that IBC/regulatory review is needed, but must not claim approval, exemption, compliance or regulatory authorization without evidence.",
      "control_type": "Decision boundary"
    }
  ],
